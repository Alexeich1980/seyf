<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Провайдер нужен ТОЛЬКО системному выбору файла (input type=file → «камера»):
         Capacitor (BridgeWebChromeClient.createImageFile) кладёт временное фото в
         getExternalFilesDir(PICTURES) и отдаёт его через authority ${applicationId}.fileprovider.
         Поэтому открываем ровно эту папку — и ничего больше.
         УБРАНЫ корневые external-path "." и cache-path "." — они делали доступным для чтения
         всё внешнее хранилище и весь кэш приложения любому, кому передан content://-URI
         (findings М-3). Своего кода, дергающего FileProvider, у «Сейфа» нет; бэкап идёт через SAF. -->
    <external-files-path name="captured_images" path="Pictures" />
</paths>
