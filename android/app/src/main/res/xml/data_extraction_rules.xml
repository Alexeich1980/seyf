<?xml version="1.0" encoding="utf-8"?>
<!-- Заслон приватности для Android 12+ (API 31+): зашифрованный vault не уезжает
     ни в облачный автобэкап, ни при переносе на новое устройство. Дополняет
     allowBackup="false", который закрывает то же на старых версиях ОС. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
